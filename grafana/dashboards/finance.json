    {
      "id": 5,
      "type": "timeseries",
      "title": "Bitcoin with SMA crossover",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-finance"
      },
      "interval": "10s",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-finance"
          },
          "query": "SELECT mean(\"btc\") FROM \"market_metrics\" WHERE $timeFilter GROUP BY time($__interval) fill(none)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "hide": false,
          "alias": "BTC"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-finance"
          },
          "query": "SELECT moving_average(mean(\"btc\"), 6) FROM \"market_metrics\" WHERE $timeFilter GROUP BY time($__interval) fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "hide": false,
          "alias": "SMA fast (6)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-finance"
          },
          "query": "SELECT moving_average(mean(\"btc\"), 30) FROM \"market_metrics\" WHERE $timeFilter GROUP BY time($__interval) fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "hide": false,
          "alias": "SMA slow (30)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Market regime (BTC trend)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-finance"
      },
      "interval": "10s",
      "description": "Rule: Bullish when the fast SMA (6) is above the slow SMA (30), otherwise Bearish. Built with Grafana server-side expressions (Reduce + Math).",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-finance"
          },
          "query": "SELECT moving_average(mean(\"btc\"), 6) FROM \"market_metrics\" WHERE $timeFilter GROUP BY time($__interval) fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "hide": true,
          "alias": "SMA fast"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-finance"
          },
          "query": "SELECT moving_average(mean(\"btc\"), 30) FROM \"market_metrics\" WHERE $timeFilter GROUP BY time($__interval) fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "hide": true,
          "alias": "SMA slow"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "A",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          },
          "hide": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "B",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          },
          "hide": true
        },
        {
          "refId": "E",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "math",
          "expression": "$C > $D",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Bullish",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Bearish",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true
      }
    },
