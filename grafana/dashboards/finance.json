      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-finance"
          },
          "query": "SELECT mean(\"gold\") FROM \"market_metrics\" WHERE $timeFilter GROUP BY time($__interval) fill(none)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "hide": false,
          "alias": "Gold"
